# ─────────────────────────────────────────────────────────────
# YouTube Content Intelligence — configuration
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
#
# Everything here is a *default*. Each account can override its own YouTube key,
# language model and search provider from the app under Settings → API access, so
# a shared install does not have to share one quota or one bill.
# ─────────────────────────────────────────────────────────────

# --- Secret for encrypting the API keys users save in Settings ---
# Any long random string, e.g. `openssl rand -hex 32`. Leave blank and those keys
# are stored in the database as typed (the backend logs a warning at startup).
# Changing it later makes existing saved keys unreadable; users just re-enter them.
APP_SECRET_KEY=

# --- YouTube Data API v3 (the default key for accounts with none of their own) ---
# Create a key at https://console.cloud.google.com/ (enable "YouTube Data API v3")
YOUTUBE_API_KEY=
# Hard cap on comments requested per single video.
YOUTUBE_MAX_COMMENTS_PER_VIDEO=200

# --- LLM provider (OpenAI-compatible /chat/completions) ---
# Works with OpenAI, OpenRouter, Together, or a local Ollama / vLLM / llama.cpp.
# For host Ollama from inside Docker use host.docker.internal and any non-empty key.
# Prefer a NON-reasoning model: "thinking" models spend minutes on hidden tokens.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b-instruct
# Generous, because generation runs as a background job and a CPU model is slow.
LLM_TIMEOUT_SECONDS=900
LLM_MAX_PROMPT_CHARS=24000

# --- Web search (grounds the ideas in current information) ---
# Off by default for every account — a smaller model tends to follow search results
# instead of the audience's own comments. These settings decide which provider is
# used by the accounts that switch it on in Settings -> Reading.
# searxng    = the default. `docker compose up` starts a private SearXNG instance
#              (also browsable on http://localhost:8888) that queries real engines
#              and, being yours, never rate-limits this app.
# duckduckgo = no API key and no container, but unofficial: it throttles repeat
#              callers and then answers with an empty challenge page.
# none       = disable.
WEB_SEARCH_PROVIDER=searxng
WEB_SEARCH_BASE_URL=http://searxng:8080
# Try DuckDuckGo when SearXNG comes back empty.
WEB_SEARCH_FALLBACK=true
# How much searching one run does. Queries are built from the topics the audience
# explicitly requested first; vague ones only fill leftover slots. Defaults shown.
#WEB_SEARCH_MAX_QUERIES=4
#WEB_SEARCH_RESULTS=4
#WEB_SEARCH_TIMEOUT_SECONDS=15
# Session secret for the bundled SearXNG. Any long random string.
SEARXNG_SECRET=change_me_searxng_secret
# What SearXNG believes its own address is (only affects links in its own UI).
SEARXNG_BASE_URL=http://localhost:8888/

# --- MySQL ---
MYSQL_DATABASE=yci
MYSQL_USERNAME=yci
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_too
# JDBC url used by Spring Boot. Inside docker-compose the host is `mysql`.
MYSQL_URL=jdbc:mysql://mysql:3306/yci?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# --- Python ML service ---
ML_SERVICE_URL=http://ml-service:8000

# --- Sessions ---
AUTH_TOKEN_TTL_DAYS=30

# --- Email digests (OPTIONAL) ---
# Leave SMTP_HOST blank to keep notifications off: the preference is still saved,
# the scheduler simply logs and skips sending. For Gmail, use an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFY_FROM=yci@localhost
# Both default to true. Set false for a local relay that wants neither.
#SMTP_AUTH=true
#SMTP_STARTTLS=true
# Checked hourly; each user is emailed on their own daily/weekly cadence.
NOTIFY_CRON=0 0 * * * *
APP_URL=http://localhost:8081
