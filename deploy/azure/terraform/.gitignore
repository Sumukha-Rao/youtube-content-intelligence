# Terraform state holds the database password and APP_SECRET_KEY in clear text.
*.tfstate
*.tfstate.*
.terraform/
# (.terraform.lock.hcl is deliberately NOT ignored — commit it so everyone
#  resolves the same provider versions.)
crash.log

# Your real values.
*.tfvars
!*.tfvars.example

# Saved plans are zip archives holding the database password, APP_SECRET_KEY and
# the API keys in clear text — the same secrets as the state file. Run logs can
# echo them too.
tfplan*
*.log
